{
  "name": "@turtleblockai/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "validate:next-edge": "node scripts/validate-next-edge.mjs",
    "validate:learner-verification": "node scripts/validate-learner-verification.mjs",
    "validate:world-evidence": "node scripts/validate-world-evidence-envelope.mjs",
    "validate:selective-attention": "node scripts/validate-selective-attention-envelope.mjs",
    "validate:plural-foreground": "node scripts/validate-plural-foreground-envelope.mjs",
    "validate:human-perturbation": "node scripts/validate-human-perturbation-translation-envelope.mjs",
    "validate:branch-experience": "node scripts/validate-branch-experience-comparison-envelope.mjs",
    "validate:cross-branch-perturbation": "node scripts/validate-cross-branch-perturbation-envelope.mjs",
    "validate:build-log-connections": "node --check public/assets/site-runtime.js && node scripts/validate-build-log-connections.mjs",
    "validate:terraria-try": "node scripts/validate-terraria-try.mjs",
    "audit:d1-coverage": "node scripts/audit-d1-coverage.mjs",
    "discord:register": "node scripts/register-discord-command.mjs",
    "validate:initiative-authority": "node -e \"const s=require('./worldspec/tests/initiative-authority-envelope-cases.json'); const a=s.cases||[]; if(a.length!==16||a.filter(x=>x.expected).length!==6) process.exit(1); console.log('Initiative Authority fixture contract passed: 16 cases, 6 valid, 10 hostile.');\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  }
}
