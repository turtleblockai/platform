{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "turtleblockai-platform",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "vars": {
    "DISCORD_APPLICATION_ID": "1544175868471943279",
    "DISCORD_PUBLIC_KEY": "a1efc3af6a53120223741a31d39e75f98e0f115fbe65f25473af48f9488b1b3c",
    "OPENAI_MODEL": "gpt-5.6-luna"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "turtleblockai",
      "database_id": "6ef1f83a-8a5f-41a7-9a9e-e4c45cec9aca"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
