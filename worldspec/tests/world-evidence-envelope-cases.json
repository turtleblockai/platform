{
  "version": "0.1",
  "name": "World Evidence Envelope regression cases",
  "purpose": "Test whether a computational world can report machine-checkable events without silently interpreting their meaning, while human, Turtle, collaborator, and synthetic interpretations retain distinct provenance.",
  "cases": [
    {
      "id": "timed-world-fact-human-meaning-pass",
      "expected_valid": true,
      "envelope": {
        "version": "0.1",
        "id": "world-evidence-velocity-001",
        "question_ref": "verify-find-flag",
        "world_event": {
          "id": "event-flag-run-1",
          "event_type": "simulation_result",
          "actor_type": "world",
          "evidence_class": "world_observation",
          "observation_only": true,
          "facts": [
            { "metric": "flag_captured", "value": true },
            { "metric": "elapsed_seconds", "value": 52.4, "unit": "seconds" }
          ],
          "source_ref": "minecraft-run-1"
        },
        "interpretations": [
          {
            "id": "interpretation-learner-speed",
            "event_id": "event-flag-run-1",
            "actor_type": "learner",
            "evidence_class": "human_interaction",
            "statement": "For my goal of reducing travel time, this route worked better than my first route.",
            "status": "held"
          }
        ],
        "criterion_relations": [
          {
            "criterion_id": "criterion-reduce-travel-time",
            "interpretation_id": "interpretation-learner-speed",
            "relation": "supports",
            "assigned_by": "learner",
            "status": "held"
          }
        ],
        "provenance": {
          "privacy_class": "private",
          "world_is_final_authority": false,
          "machine_final_authority": false,
          "reversible": true,
          "interpretation_authorship_visible": true,
          "verification_card_ref": "verify-find-flag"
        }
      }
    },
    {
      "id": "plural-interpretations-pass",
      "expected_valid": true,
      "envelope": {
        "version": "0.1",
        "id": "world-evidence-plaza-001",
        "question_ref": "verify-plaza-use",
        "world_event": {
          "id": "event-plaza-count",
          "event_type": "world_measurement",
          "actor_type": "world",
          "evidence_class": "world_observation",
          "observation_only": true,
          "facts": [
            { "metric": "avatars_in_plaza", "value": 14, "unit": "avatars", "time_ref": "minute-10" }
          ],
          "source_ref": "minecraft-observation-minute-10",
          "uncertainty": "The count does not say why participants entered or how they experienced the plaza."
        },
        "interpretations": [
          {
            "id": "interpretation-learner-busy",
            "event_id": "event-plaza-count",
            "actor_type": "learner",
            "evidence_class": "human_interaction",
            "statement": "The plaza feels lively to me with this many people moving through it.",
            "status": "intentionally_plural"
          },
          {
            "id": "interpretation-collaborator-crowded",
            "event_id": "event-plaza-count",
            "actor_type": "collaborator",
            "evidence_class": "human_interaction",
            "statement": "The same crowd makes the plaza feel too congested for the quiet gathering space I wanted.",
            "status": "intentionally_plural"
          }
        ],
        "criterion_relations": [
          {
            "criterion_id": "criterion-lively",
            "interpretation_id": "interpretation-learner-busy",
            "relation": "supports",
            "assigned_by": "learner",
            "status": "held"
          },
          {
            "criterion_id": "criterion-quiet-gathering",
            "interpretation_id": "interpretation-collaborator-crowded",
            "relation": "counters",
            "assigned_by": "collaborator",
            "status": "held"
          }
        ],
        "provenance": {
          "privacy_class": "private",
          "world_is_final_authority": false,
          "machine_final_authority": false,
          "reversible": true,
          "interpretation_authorship_visible": true,
          "verification_card_ref": "verify-plaza-use"
        }
      }
    },
    {
      "id": "world-smuggles-verdict-fail",
      "expected_valid": false,
      "expected_error": "world_event may report observations but may not contain verdict",
      "envelope": {
        "version": "0.1",
        "id": "world-evidence-verdict-001",
        "question_ref": "verify-fair-city",
        "world_event": {
          "id": "event-city-1",
          "event_type": "world_state_change",
          "actor_type": "world",
          "evidence_class": "world_observation",
          "observation_only": true,
          "facts": [
            { "metric": "entrance_count", "value": 4, "unit": "entrances" }
          ],
          "source_ref": "minecraft-city-1",
          "verdict": "The city is fair."
        },
        "interpretations": [],
        "criterion_relations": [],
        "provenance": {
          "privacy_class": "private",
          "world_is_final_authority": false,
          "machine_final_authority": false,
          "reversible": true,
          "interpretation_authorship_visible": true
        }
      }
    },
    {
      "id": "synthetic-provenance-collapse-fail",
      "expected_valid": false,
      "expected_error": "synthetic_turtle interpretation must remain synthetic_self_play",
      "envelope": {
        "version": "0.1",
        "id": "world-evidence-synthetic-001",
        "question_ref": "verify-bridge",
        "world_event": {
          "id": "event-bridge-collapse",
          "event_type": "artifact_behavior",
          "actor_type": "world",
          "evidence_class": "world_observation",
          "observation_only": true,
          "facts": [
            { "metric": "bridge_blocks_remaining", "value": 41, "unit": "blocks" }
          ],
          "source_ref": "bridge-test-1"
        },
        "interpretations": [
          {
            "id": "interpretation-synthetic",
            "event_id": "event-bridge-collapse",
            "actor_type": "synthetic_turtle",
            "evidence_class": "human_interaction",
            "statement": "Reflector Turtle interprets the collapse as evidence against the design.",
            "status": "proposed"
          }
        ],
        "criterion_relations": [],
        "provenance": {
          "privacy_class": "internal",
          "world_is_final_authority": false,
          "machine_final_authority": false,
          "reversible": true,
          "interpretation_authorship_visible": true
        }
      }
    },
    {
      "id": "relation-authorship-collapse-fail",
      "expected_valid": false,
      "expected_error": "assigned_by must match the referenced interpretation actor",
      "envelope": {
        "version": "0.1",
        "id": "world-evidence-authorship-001",
        "question_ref": "verify-welcoming-market",
        "world_event": {
          "id": "event-market-use",
          "event_type": "world_measurement",
          "actor_type": "world",
          "evidence_class": "world_observation",
          "observation_only": true,
          "facts": [
            { "metric": "entrances_used", "value": 3, "unit": "entrances" }
          ],
          "source_ref": "market-run-1"
        },
        "interpretations": [
          {
            "id": "interpretation-turtle-welcoming",
            "event_id": "event-market-use",
            "actor_type": "turtle",
            "evidence_class": "system_record",
            "statement": "Turtle proposes that use of all three entrances may support the learner's welcoming criterion.",
            "status": "proposed"
          }
        ],
        "criterion_relations": [
          {
            "criterion_id": "criterion-welcoming",
            "interpretation_id": "interpretation-turtle-welcoming",
            "relation": "supports",
            "assigned_by": "learner",
            "status": "held"
          }
        ],
        "provenance": {
          "privacy_class": "private",
          "world_is_final_authority": false,
          "machine_final_authority": false,
          "reversible": true,
          "interpretation_authorship_visible": true
        }
      }
    },
    {
      "id": "world-final-authority-fail",
      "expected_valid": false,
      "expected_error": "world_is_final_authority must be false",
      "envelope": {
        "version": "0.1",
        "id": "world-evidence-final-authority-001",
        "question_ref": "verify-village",
        "world_event": {
          "id": "event-village-1",
          "event_type": "world_measurement",
          "actor_type": "world",
          "evidence_class": "world_observation",
          "observation_only": true,
          "facts": [
            { "metric": "travel_distance", "value": 120, "unit": "blocks" }
          ],
          "source_ref": "village-walk-1"
        },
        "interpretations": [],
        "criterion_relations": [],
        "provenance": {
          "privacy_class": "private",
          "world_is_final_authority": true,
          "machine_final_authority": false,
          "reversible": true,
          "interpretation_authorship_visible": true
        }
      }
    }
  ]
}
