{
  "version": "0.1",
  "name": "Learner Verification Card regression cases",
  "purpose": "Test whether verification remains learner-authored, inspectable, reversible, provenance-aware, and open to counterevidence instead of becoming hidden machine judgment.",
  "cases": [
    {
      "id": "learner-counterexample-pass",
      "expected_valid": true,
      "card": {
        "version": "0.1",
        "id": "verify-forest-agency-001",
        "question": {
          "statement": "Can the village meet its needs without treating the forest as an enemy?",
          "authored_by": "learner"
        },
        "criteria": [
          {
            "id": "criterion-forest-agency",
            "statement": "A successful design should preserve places where the forest can continue changing without being controlled by the village.",
            "authored_by": "learner",
            "status": "accepted",
            "success_condition": "The built world leaves at least one meaningful forest area outside village control.",
            "uncertainty": "What counts as meaningful space may change after walking through the world."
          }
        ],
        "evidence": [
          {
            "id": "evidence-clearing",
            "criterion_ids": ["criterion-forest-agency"],
            "evidence_type": "world_observation",
            "statement": "Walking the first build shows that every path and resource zone still converges on village control.",
            "actor_type": "world",
            "evidence_class": "world_observation",
            "relation": "counters",
            "interpreted_by": "learner",
            "uncertainty": "A different path through the world might reveal areas that feel less controlled."
          }
        ],
        "decision_status": "provisional",
        "reflection": {
          "expected": "Leaving trees standing would be enough to preserve forest agency.",
          "observed": "The village still organizes the forest around its own needs.",
          "surprise": "Preservation and control are not opposites in the way I first assumed.",
          "changed_mind": true,
          "next_question": "What would the forest be able to do in this world if the village were not the only designer?"
        },
        "provenance": {
          "evidence_class": "human_interaction",
          "privacy_class": "private",
          "criteria_authorship_visible": true,
          "machine_final_authority": false,
          "reversible": true,
          "worldspec_revision": "rev-forest-2"
        }
      }
    },
