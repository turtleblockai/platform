        },
        "criteria": [
          {
            "id": "criterion-view",
            "statement": "I want a clear view across the square.",
            "authored_by": "learner",
            "status": "accepted"
          },
          {
            "id": "criterion-shelter",
            "statement": "I want the wall to keep the smaller garden feeling sheltered.",
            "authored_by": "collaborator",
            "status": "accepted"
          }
        ],
        "evidence": [
          {
            "id": "evidence-open-view",
            "criterion_ids": ["criterion-view"],
            "evidence_type": "artifact_test",
            "statement": "Removing the wall opens the view across the square.",
            "actor_type": "learner",
            "evidence_class": "human_interaction",
            "relation": "supports",
            "interpreted_by": "learner"
          },
          {
            "id": "evidence-lost-shelter",
            "criterion_ids": ["criterion-shelter"],
            "evidence_type": "collaborator_observation",
            "statement": "Without the wall, the smaller garden no longer feels separate or sheltered to the collaborator who proposed that criterion.",
            "actor_type": "collaborator",
            "evidence_class": "human_interaction",
            "relation": "counters",
            "interpreted_by": "collaborator"
          }
        ],
        "decision_status": "intentionally_plural",
        "reflection": {
          "observed": "The same change satisfies one criterion and undermines another.",
          "changed_mind": false,
          "next_question": "Can we test a version that preserves both experiences without pretending we already agree?"
        },
