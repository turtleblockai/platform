{
  "version": "0.1",
  "name": "Selective Attention Envelope regression cases",
  "purpose": "Test whether TurtleBlock AI can distinguish an observable world event from retention, salience, surfacing, and interruption while preserving learner-authored attention, privacy, silence, provenance, and the boundary against surveillance expansion.",
  "cases": [
    {
      "id": "learner-watchpoint-interrupt-pass",
      "expected_valid": true,
      "envelope": {
        "version": "0.1",
        "id": "attention-bridge-collapse-001",
        "question_ref": "question-bridge-stability",
        "world_event_ref": "event-bridge-collapse",
        "attention_context": {
          "mode": "watchpoint_only",
          "source": "learner_stated"
        },
        "attention_rule": {
          "id": "watchpoint-bridge-collapse",
          "purpose_ref": "learner-purpose-test-bridge",
          "authored_by": "learner",
          "evidence_class": "human_interaction",
          "basis": "learner_watchpoint",
          "status": "active",
          "trigger_description": "Tell me immediately if the bridge collapses while I test it.",
          "new_collection_authorized": false
        },
        "decision": {
          "actor_type": "turtle",
          "evidence_class": "system_record",
          "action": "surface_now",
          "rationale": "The observed collapse matches an active learner-authored watchpoint.",
          "interruptive": true,
          "delivery_audience": "learner",
          "retention": "ephemeral_private",
          "status": "executed"
        },
        "provenance": {
          "source_event_privacy_class": "private",
          "event_content_duplicated": false,
          "learner_can_mute": true,
          "learner_can_revise": true,
          "machine_salience_is_proposal": true,
          "machine_final_authority": false,
          "surveillance_expansion_authorized": false,
          "reversible": true,
          "non_interruption_is_valid": true
        }
      }
    },
    {
      "id": "deliberate-silence-pass",
      "expected_valid": true,
      "envelope": {
        "version": "0.1",
        "id": "attention-plaza-flow-001",
        "question_ref": "question-plaza-play",
        "world_event_ref": "event-plaza-count",
        "attention_context": {
          "mode": "do_not_interrupt",
          "source": "learner_stated"
        },
        "attention_rule": {
          "id": "attention-plaza-routine",
          "purpose_ref": "learner-purpose-free-build",
          "authored_by": "learner",
          "evidence_class": "human_interaction",
          "basis": "learner_session_setting",
          "status": "active",
          "trigger_description": "Do not interrupt me with routine plaza counts while I am building.",
          "new_collection_authorized": false
        },
        "decision": {
          "actor_type": "turtle",
          "evidence_class": "system_record",
          "action": "remain_silent",
          "rationale": "The event does not match an urgent learner watchpoint and the learner explicitly requested uninterrupted making.",
          "interruptive": false,
          "delivery_audience": "none",
          "retention": "discard_after_decision",
          "status": "executed"
        },
        "provenance": {
          "source_event_privacy_class": "private",
          "event_content_duplicated": false,
          "learner_can_mute": true,
          "learner_can_revise": true,
          "machine_salience_is_proposal": true,
          "machine_final_authority": false,
          "surveillance_expansion_authorized": false,
          "reversible": true,
          "non_interruption_is_valid": true
        }
      }
    },
